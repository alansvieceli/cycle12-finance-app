{
  "expo": {
    "name": "Cycle12 Finance",
    "slug": "cycle12-finance-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon-finance.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121212",
        "foregroundImage": "./assets/adaptive-icon-finance.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.cycle12financeapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo-finance.png",
          "backgroundColor": "#121212",
          "resizeMode": "contain",
          "imageWidth": 280
        }
      ],
      "./plugins/with-android-centered-splash",
      "expo-sharing"
    ]
  }
}
